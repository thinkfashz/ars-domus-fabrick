fotos/
fuentes/

# --- Node y build ----------------------------------------------------
node_modules/
dist/

# --- Python ----------------------------------------------------------
__pycache__/
*.pyc
.venv/

# --- Ajustes locales de Claude Code ----------------------------------
.claude/settings.local.json

# --- Lo que se mueve en el visor (lo lee Claude y lo pasa a los datos) ---
cambios.json

# --- Las casas de verdad: privadas, nunca en este repo ---
casas/

# --- Workflows: el token de git de este entorno no tiene scope 'workflow' ---
# El flujo de GitHub Pages vive en el repo remoto (se creo por API) y se edita
# desde la web de GitHub; localmente se conserva la copia de referencia.
.github/workflows/
